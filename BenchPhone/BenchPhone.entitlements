<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<key>keychain-access-groups</key>
	<array>
		<!-- First, so the app's own items (its pairings) stay private to it. -->
		<string>$(AppIdentifierPrefix)$(BENCH_BUNDLE_PREFIX).BenchPhone</string>
		<!-- Shared with the notification extension: only the notification keys. -->
		<string>$(AppIdentifierPrefix)$(BENCH_BUNDLE_PREFIX).BenchPhone.shared</string>
	</array>
</dict>
</plist>
